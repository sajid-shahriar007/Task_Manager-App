PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (rotate credentials, never commit the real one)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/task_manager?retryWrites=true&w=majority

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Firebase Admin SDK service account (download from Firebase Console -> Project Settings -> Service Accounts)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
